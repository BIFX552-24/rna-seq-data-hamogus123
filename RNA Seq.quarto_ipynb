      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"RNA Seq\"\n",
        "format: html\n",
        "editor: visual\n",
        "---\n",
        "\n",
        "\n",
        "## \n",
        "\n",
        "\n",
        "```{bash setup}\n",
        "#| echo: fasle\n",
        "#| eval: false\n",
        "\n",
        "#working directory on the cluster: ~/rna_seq\n",
        "\n",
        "#link to my data\n",
        "ln -s /home/ham14/data/SRR35819952_* .\n",
        "```\n",
        "\n",
        "```{bash}\n",
        "#| label: download\n",
        "#| echo: false\n",
        "#| eval: true\n",
        "\n",
        "#Download the dataset\n",
        "fasterq-dump SRR35819952\n",
        "\n",
        "#gzip dataset\n",
        "gzip SRR35819952_?.fastq\n",
        "\n",
        "```\n",
        "\n",
        "```{QC}\n",
        "#| echo: false\n",
        "#| eval: false\n",
        "\n",
        "#Run QC\n",
        "fastqc SRR35819952_?.fastq.gz\n",
        "```\n",
        "\n",
        "```{Trim and Rerun QC}\n",
        "#| echo: false\n",
        "#| eval: false\n",
        "\n",
        "#Trim\n",
        "trimmomatic PE -threads 1 \\\n",
        "  SRR35819952_1.fastq.gz SRR35819952_2.fastq.gz \\\n",
        "  r1_trim.fastq.gz r1_trim_unpaired.fastq.gz \\\n",
        "  r2_trim.fastq.gz r2_trim_unpaired.fastq.gz \\\n",
        "  SLIDINGWINDOW:4:20\n",
        "  MINLEN:25\n",
        "  \n",
        "#Re-run QC\n",
        "fastqc r?_trim.fastq.gz\n",
        "```"
      ],
      "id": "d84c69ae"
    }
  ],
