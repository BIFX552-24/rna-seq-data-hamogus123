  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Differential Gene Expression Analysis\"\n",
        "format: docx\n",
        "editor: visual\n",
        "---\n",
        "\n",
        "```{B}\n",
        "#Loading Packages\n",
        "library(dplyr)\n",
        "library(purrr)\n",
        "library(readr)\n",
        "library(edgeR)\n",
        "library(pathview)\n",
        "library(AnnotationDbi)\n",
        "library(org.Mm.eg.db)\n",
        "```\n",
        "\n",
        "```{D}\n",
        "#Download data\n",
        "scp ham14@144.175.88.28:\"/home/johnson/rna-seq-johnsonra/*_gene_count_matrix.txt\" .\n",
        "```\n",
        "\n",
        "```{W}\n",
        "#Data Wrangling\n",
        "# List the files\n",
        "files <- list.files(\"data\", pattern = \"*_gene_count_matrix.txt\")\n",
        "\n",
        "# Create a list of data frames\n",
        "data <- map(file.path('data', files), \n",
        "            ~ read.delim(.x, header = TRUE, skip = 1) |> select(c(1,6,7))) |>\n",
        "\n",
        "    # and merge into a single data frame\n",
        "    reduce(full_join, by = c('Geneid', 'Length'))\n",
        "\n",
        "# drop any bits of each name that aren't needed\n",
        "names(data) <- substr(names(data), 1, 11)\n",
        "\n",
        "# experimental groups\n",
        "group <- read_csv(\"data/groups.csv\") |>\n",
        "    filter(aid %in% names(data)) # only keep accession IDs that were successfully aligned\n",
        "```\n",
        "\n",
        "```{E}\n",
        "# Create DGEList object\n",
        "y <- DGEList(counts = select(data, -Length, -Geneid),\n",
        "             group = group$CXCR4,\n",
        "             genes = data$Geneid,\n",
        "             remove.zeros = TRUE)\n",
        "\n",
        "# Filtering\n",
        "keep <- filterByExpr(y)\n",
        "y <- y[keep, , keep.lib.sizes=FALSE]\n",
        "\n",
        "# Normalization\n",
        "y <- calcNormFactors(y)\n",
        "```\n",
        "\n",
        "```{DEG}\n",
        "# Design matrix\n",
        "design <- model.matrix(~group$CXCR4)\n",
        "\n",
        "# Estimate dispersion\n",
        "y <- estimateDisp(y, design)\n",
        "\n",
        "# Fit the model\n",
        "fit <- glmQLFit(y, design)\n",
        "\n",
        "# Conduct quasi-likelihood F-test\n",
        "qlf <- glmQLFTest(fit, coef=2)\n",
        "\n",
        "# Get the top differentially expressed genes\n",
        "top_tags <- topTags(qlf)\n",
        "```\n",
        "\n",
        "```{Plot}\n",
        "plotMD(qlf, main=\"Pos vs Neg\")\n",
        "```\n",
        "\n",
        "```{K}\n",
        "# Perform KEGG analysis\n",
        "kegg_results <- kegga(qlf, species = \"Mm\")\n",
        "\n",
        "# Display top pathways\n",
        "topKEGG(kegg_results)\n",
        "```\n",
        "\n",
        "```{Pathview}\n",
        "\n",
        "# Get the logFC values for all genes\n",
        "logfc <- qlf$table$logFC\n",
        "\n",
        "# Get the Entrez IDs\n",
        "entrez_ids <- mapIds(org.Mm.eg.db, keys = qlf$genes$genes, column = \"ENTREZID\", keytype = \"SYMBOL\", multiVals = \"first\")\n",
        "names(logfc) <- entrez_ids\n",
        "\n",
        "# Get the top pathway ID (since there are no sigificant pathways, we'll go with the MAPK signaling pathway)\n",
        "top_pathway_id <- \"04010\" #rownames(topKEGG(kegg_results))[1]\n",
        "\n",
        "# Generate the pathview\n",
        "pathview(gene.data = logfc, pathway.id = top_pathway_id, species = \"mmu\", kegg.native = TRUE)\n",
        "```"
      ],
      "id": "32d1dbbd"
    }
  ],
